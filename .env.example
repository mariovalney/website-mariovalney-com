# The public URL of the site. Optional: src/lib/site.ts already carries the production domain,
# and this only overrides it — for a staging or preview build.
#
# It is inlined into the bundle during `pnpm build`, so setting it in the hosting panel after the
# image is built has no effect. Change it here, or pass it as a --build-arg, and rebuild.
NEXT_PUBLIC_SITE_URL=https://mariovalney.com
